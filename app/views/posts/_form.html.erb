<%= form_with(model: post, class: "card", style: "max-width: 600px; margin: 0 auto;") do |form| %>
  <% if post.errors.any? %>
    <div class="flash alert">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title, placeholder: "Enter post title..." %>
  </div>

  <div class="form-group">
    <%= form.label :body %>
    <%= form.text_area :body, rows: 10, placeholder: "Write your content here..." %>
  </div>

  <div class="form-group">
    <%= form.label :status %>
    <%= form.select :status, Post.statuses.keys.map { |s| [s.humanize, s] } %>
  </div>

  <div class="actions" style="margin-top: 2rem;">
    <%= form.submit class: "btn btn-primary", style: "width: 100%;" %>
  </div>
<% end %>
