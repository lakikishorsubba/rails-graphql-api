<div id="<%= dom_id post %>" class="card post-card">
  <div>
    <span class="post-status status-<%= post.status %>">
      <%= post.status %>
    </span>
    <h2><%= post.title %></h2>
    <p style="color: var(--text-muted); margin-bottom: 1rem;">
      <%= truncate(post.body, length: 150) %>
    </p>
  </div>

  <div class="actions">
    <%= link_to "View Details", post, class: "btn btn-outline", style: "flex: 1" %>
    <%= link_to "Edit", edit_post_path(post), class: "btn btn-outline" %>
  </div>
</div>
