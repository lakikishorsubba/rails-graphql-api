<div class="card" style="max-width: 800px; margin: 0 auto;">
  <span class="post-status status-<%= @post.status %>">
    <%= @post.status %>
  </span>
  <h1 style="color: var(--secondary);"><%= @post.title %></h1>
  
  <div style="margin: 2rem 0; font-size: 1.1rem; line-height: 1.8;">
    <%= simple_format @post.body %>
  </div>

  <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.1); margin: 2rem 0;">

  <div class="actions" style="justify-content: flex-end;">
    <%= link_to "Back to Feed", posts_path, class: "btn btn-outline" %>
    <%= link_to "Edit Post", edit_post_path(@post), class: "btn btn-outline" %>
    <%= button_to "Delete", @post, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
